<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <%# FMT-01 (revisión Jhan): CSP que el navegador OBLIGA. Chromium corre con
      --no-sandbox sobre file://, y las plantillas llevan datos del cliente; sin
      esto, un dato con raw/html_safe podria colar <iframe src="file:///..."> y
      filtrar el sistema al PDF. default-src 'none' bloquea todo; solo se permite
      el <style> inline, imagenes y fuentes en data URI. Nada remoto ni file://. %>
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; img-src data:; font-src data:">
  <title><%= content_for?(:titulo) ? yield(:titulo) : 'Formato Only Home' %></title>
  <style>
    /* FMT-01: CSS de impresion. CERO recursos remotos: todo va inline (el logo,
       cuando lo haya, entra como data URI). Chromium respeta @page para A4. */
    @page { size: A4; margin: 16mm 15mm; }

    * { box-sizing: border-box; }

    body {
      /* Carlito y Liberation Sans son metricas equivalentes a Calibri y Arial;
         se instalan en el contenedor (fonts-crosextra-carlito, fonts-liberation). */
      font-family: 'Carlito', 'Liberation Sans', 'DejaVu Sans', Arial, sans-serif;
      font-size: 10.5pt;
      line-height: 1.35;
      color: #111;
      margin: 0;
    }

    h1 { font-size: 15pt; margin: 0 0 2pt; }
    h2 { font-size: 12pt; margin: 10pt 0 4pt; }
    h3 { font-size: 10.5pt; margin: 8pt 0 3pt; }
    p { margin: 0 0 6pt; }

    .encabezado {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      border-bottom: 2px solid #111;
      padding-bottom: 6pt;
      margin-bottom: 10pt;
    }
    .encabezado .marca { font-weight: 700; letter-spacing: .02em; }
    .encabezado .numero-formato { font-weight: 700; font-size: 13pt; }

    table { width: 100%; border-collapse: collapse; margin: 6pt 0; }
    th, td { border: 1px solid #333; padding: 4pt 6pt; text-align: left; vertical-align: top; }
    th { background: #f0f0f0; font-weight: 700; }

    .campos { border: 1px solid #333; }
    .campos td { border: none; border-bottom: 1px solid #ccc; }
    .campos .etiqueta { font-weight: 700; width: 32%; }

    .firmas { display: flex; justify-content: space-between; gap: 24pt; margin-top: 28pt; }
    .firmas .firma { flex: 1; border-top: 1px solid #111; padding-top: 4pt; text-align: center; font-size: 9.5pt; }

    .legal { font-size: 8.5pt; color: #333; margin: 6pt 0; text-align: justify; }
    .nota { font-size: 9pt; color: #555; }

    /* control de cortes de pagina */
    .salto-antes { page-break-before: always; }
    .sin-corte { page-break-inside: avoid; }
    thead { display: table-header-group; }
    tr { page-break-inside: avoid; }
  </style>
</head>
<body>
  <%= yield %>
</body>
</html>
